# Heartbeat alert destination — copy to alert.env and fill ONE of these.
# alert.env is gitignored (never commit secrets). Pick the simplest for you.

# Discord (simplest: create Server Settings → Integrations → Webhooks → New Webhook, copy URL)
DISCORD_WEBHOOK_URL=

# Telegram (create a bot via @BotFather for the token; get your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic — any endpoint that accepts POST {"text":...} (e.g. Slack incoming webhook)
ALERT_WEBHOOK_URL=
