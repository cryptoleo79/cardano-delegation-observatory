# Runtime data — regenerated by ETL on the server, never committed.
# Exception: the small, static, archive-derived Project Memory export, which is
# deployed via git (it is not server-generated by the ETL pipeline).
/data/*
!/data/snapshots
/data/snapshots/*
!/data/snapshots/projectmemory
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# Editor / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/
